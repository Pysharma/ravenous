# ---------------------------------------------------------------------------
# Ravenous Multi Cuisine Restaurant — environment configuration
# Copy to .env and fill in real values. Never commit real credentials.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Session signing secrets — use long random strings in production
AUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-too

# Maps / geocoding (optional — a built-in Bilaspur locality table is used as fallback)
MAPS_API_KEY=

# Payments — Razorpay (test or live). Secrets stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email delivery (optional — Resend compatible API key)
EMAIL_API_KEY=
EMAIL_FROM=Ravenous <orders@example.com>
ADMIN_EMAIL=owner@example.com

# SMS / WhatsApp providers (optional)
SMS_API_KEY=
WHATSAPP_API_KEY=

# Object storage (optional — local /public/uploads is used when unset)
STORAGE_API_KEY=
STORAGE_BUCKET=

# Public site URL used for SEO, sitemap and QR links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
